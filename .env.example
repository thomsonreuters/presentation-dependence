# Hugging Face access for gated model weights and datasets.
HF_TOKEN=

# Closed-model baselines. OPENAI_BASE_URL is only needed for a non-default
# or self-hosted OpenAI-compatible endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional: where run artifacts live, if not ./runs. Sets the default for
# every runner's --runs-root, which still wins when passed explicitly.
SLM_RUNS_ROOT=

# Optional: GPU count, when it should not be autodetected.
SLM_NUM_GPUS=
